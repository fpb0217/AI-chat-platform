# DeepSeek credentials stay on the API server and are never exposed to Vite.
DEEPSEEK_API_KEY=sk-replace-with-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Local runtime defaults.
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=data/chat.db
WEB_DIST_PATH=apps/web/dist
DEEPSEEK_REQUEST_TIMEOUT_MS=600000

